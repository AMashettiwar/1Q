# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud > App > Settings > Secrets. Never commit the real file.

# --- Questions (Groq today, swappable) ---
LLM_PROVIDER = "groq"            # groq | openai | none
LLM_MODEL = "llama-3.3-70b-versatile"
GROQ_API_KEY = "gsk_..."
# OPENAI_API_KEY = "..."          # for LLM_PROVIDER = "openai" (any OpenAI-compatible API)
# OPENAI_BASE_URL = "https://..."

# --- Database (required in production; Community Cloud disk is wiped on restart) ---
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- Sign-in ---
AUTH_MODE = "google"             # google | email_otp | demo
ALLOWED_DOMAIN = "1cell.ai"
ADMIN_EMAILS = "ankith@1cell.ai"

# --- Email (one-time codes for email_otp, and daily reminders) ---
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "quiz@1cell.ai"
SMTP_PASSWORD = "app-password"
SMTP_FROM = "1Q <quiz@1cell.ai>"
APP_URL = "https://your-app.streamlit.app"

# --- Google sign-in (Streamlit OIDC). Needed when AUTH_MODE = "google" ---
[auth]
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { hd = "1cell.ai", prompt = "select_account" }
